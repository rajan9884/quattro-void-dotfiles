#!/usr/bin/env bash
# Wayland Screenshot Utility (grim + slurp + wl-copy)
set -euo pipefail

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/screenshot-$(date +%Y%m%d-%H%M%S).png"

if [ "${1:-region}" = "full" ]; then
    grim "$FILE"
else
    geom=$(slurp 2>/dev/null || true)
    [ -z "$geom" ] && exit 0
    grim -g "$geom" "$FILE"
fi

wl-copy < "$FILE"
notify-send "Screenshot Captured" "Saved to $FILE and copied to clipboard"
