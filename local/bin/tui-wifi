#!/usr/bin/env bash
# TUI Wi-Fi Manager (impala -> nmtui -> nmcli+fzf)
set -euo pipefail

if [ "${1:-}" = "--toggle" ]; then
    if command -v nmcli >/dev/null 2>&1; then
        state=$(nmcli radio wifi)
        if [ "$state" = "enabled" ]; then
            nmcli radio wifi off
            notify-send "Wi-Fi" "Radio disabled"
        else
            nmcli radio wifi on
            notify-send "Wi-Fi" "Radio enabled"
        fi
    fi
    exit 0
fi

if command -v impala >/dev/null 2>&1; then
    exec ~/.local/bin/launch-tui-popup impala
elif command -v nmtui >/dev/null 2>&1; then
    exec ~/.local/bin/launch-tui-popup nmtui
else
    exec ~/.local/bin/launch-tui-popup bash -c '
        selected=$(nmcli --fields "SECURITY,BARS,SSID" device wifi list | sed 1d | fzf --prompt="Wi-Fi > " --reverse --header="Select network to connect")
        if [ -n "$selected" ]; then
            ssid=$(echo "$selected" | awk "{print \$NF}")
            nmcli device wifi connect "$ssid" --ask
        fi
    '
fi
