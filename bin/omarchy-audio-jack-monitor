#!/usr/bin/env python3
"""
omarchy-audio-jack-monitor: Dynamic headphone jack insertion listener for Void Linux.
Listens to kernel input switch events (SW_HEADPHONE_INSERT) and automatically routes
audio to Headphones when plugged in, and back to Speakers (omarchy_speaker_tuning)
when unplugged.
"""

import os
import sys
import glob
import time
import fcntl
import struct
import select
import subprocess

# Linux input event struct format: time_sec (l), time_usec (l), type (H), code (H), value (i)
EVENT_FORMAT = "llHHI"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
EV_SW = 0x05
SW_HEADPHONE_INSERT = 0x02

# ioctl EVIOCGSW(8)
EVIOCGSW = (2 << 30) | (8 << 16) | (ord("E") << 8) | 0x1B

HP_SINK = "alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Headphones__sink"
SPK_SINK = "omarchy_speaker_tuning"


def find_headphone_device():
    for p in glob.glob("/sys/class/input/event*/device/name"):
        try:
            with open(p, "r", encoding="utf-8") as f:
                name = f.read().strip()
                if "Front Headphone" in name or "Headphone Jack" in name:
                    event_id = p.split("/")[4]
                    dev_node = f"/dev/input/{event_id}"
                    if os.path.exists(dev_node):
                        return dev_node
        except Exception:
            continue
    return None


def get_switch_state(fd):
    try:
        buf = bytearray(8)
        fcntl.ioctl(fd, EVIOCGSW, buf)
        val = int.from_bytes(buf, "little")
        return (val >> SW_HEADPHONE_INSERT) & 1
    except Exception:
        return None


def switch_output(to_headphones):
    sink = HP_SINK if to_headphones else SPK_SINK
    subprocess.run(["omarchy-audio-output-set-default", "0", sink], check=False)


def main():
    last_state = None

    while True:
        dev_path = find_headphone_device()
        if not dev_path:
            time.sleep(2)
            continue

        try:
            fd = os.open(dev_path, os.O_RDONLY | os.O_NONBLOCK)
        except Exception:
            time.sleep(2)
            continue

        initial_state = get_switch_state(fd)
        if initial_state is not None:
            last_state = initial_state
            # If plugged in at daemon start, automatically switch to headphones
            if initial_state == 1:
                switch_output(True)

        try:
            poll = select.poll()
            poll.register(fd, select.POLLIN | select.POLLERR | select.POLLHUP)

            while True:
                events = poll.poll(5000)
                if not events:
                    continue

                for f_fd, event in events:
                    if event & (select.POLLERR | select.POLLHUP):
                        raise OSError("Device disconnected")

                    data = os.read(fd, EVENT_SIZE * 8)
                    for i in range(0, len(data), EVENT_SIZE):
                        chunk = data[i:i + EVENT_SIZE]
                        if len(chunk) < EVENT_SIZE:
                            break
                        _, _, ev_type, code, value = struct.unpack(EVENT_FORMAT, chunk)
                        if ev_type == EV_SW and code == SW_HEADPHONE_INSERT:
                            if value != last_state:
                                last_state = value
                                switch_output(value == 1)
        except (OSError, Exception):
            try:
                os.close(fd)
            except Exception:
                pass
            time.sleep(1)


if __name__ == "__main__":
    main()
