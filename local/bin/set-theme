#!/usr/bin/env bash
# Applies a Quattro theme (colors.toml + shell.toml + theme.json + hypr-theme.conf)
# Called directly from Quickshell's UnifiedMenu Style > Theme section
set -euo pipefail

slug="${1:-tokyo-night}"
THEMES_DIR="$HOME/.config/themes"

if [ ! -d "$THEMES_DIR/$slug" ]; then
    notify-send "Theme Error" "Unknown theme: $slug"
    exit 1
fi

mkdir -p "$HOME/.local/state/quattro/current"
echo "$slug" > "$HOME/.local/state/quattro/current/theme.name"

# 1. Update Quickshell live files (FileView reloads immediately with 420ms crossfade!)
cp "$THEMES_DIR/$slug/theme.json" "$HOME/.config/quickshell/theme.json"
cp "$THEMES_DIR/$slug/colors.toml" "$HOME/.config/quickshell/colors.toml"
cp "$THEMES_DIR/$slug/shell.toml" "$HOME/.config/quickshell/shell.toml"

# 2. Update Hyprland border & surface tokens and reload compositor
cp "$THEMES_DIR/$slug/hypr-theme.conf" "$HOME/.config/hypr/conf/theme.conf"
hyprctl reload >/dev/null 2>&1 || true

notify-send "Quattro Theme" "Activated theme: $slug"
