#!/usr/bin/env bash
set -euo pipefail
if [ "${1:-}" = "--toggle" ]; then
    if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
        bluetoothctl power off
        notify-send "Bluetooth" "Powered off"
    else
        bluetoothctl power on
        notify-send "Bluetooth" "Powered on"
    fi
    exit 0
fi
if command -v bluetuith >/dev/null 2>&1; then
    exec ~/.local/bin/launch-tui-popup bluetuith
elif command -v bluetui >/dev/null 2>&1; then
    exec ~/.local/bin/launch-tui-popup bluetui
else
    exec ~/.local/bin/launch-tui-popup bash -c '
        bluetoothctl power on >/dev/null 2>&1 || true
        dev=$(bluetoothctl devices | fzf --prompt="Bluetooth Device > " --reverse --header="Enter to Connect / Disconnect")
        mac=$(awk "{print \$2}" <<<"$dev")
        [ -n "$mac" ] && bluetoothctl connect "$mac"
    '
fi
