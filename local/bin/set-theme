#!/usr/bin/env bash
set -euo pipefail

theme="${1:-tokyo-night}"

if command -v void-theme-set >/dev/null 2>&1; then
    exec void-theme-set "$theme"
elif [ -x /usr/share/void/bin/void-theme-set ]; then
    exec /usr/share/void/bin/void-theme-set "$theme"
else
    echo "Error: void-theme-set not found" >&2
    exit 1
fi
