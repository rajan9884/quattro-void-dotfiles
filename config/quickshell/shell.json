{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "background": "opaque",
    "sizeHorizontal": 26,
    "sizeVertical": 28,
    "layout": {
      "left": [
        {
          "id": "menu"
        },
        {
          "id": "spacer",
          "size": 12
        },
        {
          "id": "workspaces"
        }
      ],
      "centerBegin": [
        {
          "id": "indicators"
        },
        {
          "id": "media"
        }
      ],
      "center": [
        {
          "id": "clock",
          "format": "ddd dd MMM  HH:mm"
        }
      ],
      "centerEnd": [
        {
          "id": "sysload"
        }
      ],
      "right": [
        {
          "id": "clipboard"
        },
        {
          "id": "microphone"
        },
        {
          "id": "audio"
        },
        {
          "id": "network"
        },
        {
          "id": "bluetooth"
        },
        {
          "id": "monitor"
        },
        {
          "id": "power"
        }
      ]
    }
  }
}
