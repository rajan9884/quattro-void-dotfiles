#!/usr/bin/env bash
# Robust audio initialization for Void Linux under Wayland / Hyprland
set -euo pipefail

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

# Ensure runtime directory exists
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true

# If pipewire is not active, clean up stale sockets and spawn detached session
if ! pgrep -u "$USER" -x pipewire >/dev/null 2>&1; then
    rm -f "$XDG_RUNTIME_DIR"/pipewire-*.lock "$XDG_RUNTIME_DIR"/pipewire-0* "$XDG_RUNTIME_DIR"/pulse/native 2>/dev/null || true
    setsid /usr/bin/pipewire >/dev/null 2>&1 &
    sleep 0.5
fi

# WirePlumber and PipeWire-Pulse are usually auto-spawned via context.exec,
# but verify and launch if either is missing.
if ! pgrep -u "$USER" -x wireplumber >/dev/null 2>&1; then
    setsid /usr/bin/wireplumber >/dev/null 2>&1 &
fi

if ! pgrep -u "$USER" -x pipewire-pulse >/dev/null 2>&1; then
    setsid /usr/bin/pipewire-pulse >/dev/null 2>&1 &
fi
