{
  "apps": {
    "icon": "󰀻",
    "label": "Apps",
    "aliases": [
      "app",
      "applications"
    ],
    "provider": "apps"
  },
  "appearance": {
    "icon": "󰏘",
    "label": "Appearance",
    "aliases": [
      "style"
    ]
  },
  "trigger": {
    "icon": "󱓞",
    "label": "Trigger"
  },
  "setup": {
    "icon": "",
    "label": "Setup",
    "aliases": [
      "settings"
    ]
  },
  "install": {
    "icon": "󰉉",
    "label": "Install"
  },
  "remove": {
    "icon": "󰭌",
    "label": "Remove",
    "aliases": [
      "uninstall"
    ]
  },
  "system": {
    "icon": "",
    "label": "System",
    "aliases": [
      "power-menu"
    ]
  },
  "system.screensaver": {
    "icon": "󱄄",
    "label": "Screensaver",
    "action": "void-launch-screensaver force"
  },
  "system.lock": {
    "icon": "",
    "label": "Lock",
    "action": "void-system-lock"
  },
  "system.suspend": {
    "icon": "󰒲",
    "label": "Suspend",
    "when": "! void-toggle-enabled suspend-off && ! void-sleep-disabled",
    "action": "void-system suspend"
  },
  "system.hibernate": {
    "icon": "󰤁",
    "label": "Hibernate",
    "when": "void-hibernation-available && ! void-sleep-disabled",
    "action": "void-system hibernate"
  },
  "system.logout": {
    "icon": "󰍃",
    "label": "Logout",
    "action": "void-system logout"
  },
  "system.reboot": {
    "icon": "󰜉",
    "label": "Reboot",
    "action": "void-system reboot"
  },
  "system.shutdown": {
    "icon": "󰐥",
    "label": "Shutdown",
    "action": "void-system shutdown"
  },
  "appearance.theme": {
    "icon": "󰸌",
    "label": "Theme",
    "aliases": [
      "theme",
      "themes"
    ],
    "action": "void-shell shell summon omarchy.image-picker '{\"source\":\"themes\"}'"
  },
  "appearance.background": {
    "icon": "",
    "label": "Background",
    "aliases": [
      "background",
      "wallpaper"
    ],
    "action": "background=$(void-theme-bg-switcher); [[ -n $background ]] && void-theme-bg-set \"$background\""
  },
  "appearance.font": {
    "icon": "",
    "label": "Font",
    "provider": "fonts"
  },
  "appearance.top-bar": {
    "icon": "󰍜",
    "label": "Menu Bar"
  },
  "appearance.top-bar.hide": {
    "icon": "󰈉",
    "label": "Hide Bar",
    "when": "! void-toggle-enabled bar-off",
    "action": "void-toggle-bar"
  },
  "appearance.top-bar.show": {
    "icon": "󰈈",
    "label": "Show Bar",
    "when": "void-toggle-enabled bar-off",
    "action": "void-toggle-bar"
  },
  "appearance.top-bar.position": {
    "icon": "",
    "label": "Position Bar"
  },
  "appearance.top-bar.background": {
    "icon": "󰂵",
    "label": "Bar Background"
  },
  "appearance.top-bar.background.opaque": {
    "icon": "󰝤",
    "label": "Opaque Bar",
    "checked": "[[ $(void-bar background) == \"opaque\" ]]",
    "action": "void-bar background opaque"
  },
  "appearance.top-bar.background.glassy": {
    "icon": "󰂵",
    "label": "Glassy Bar",
    "checked": "[[ $(void-bar background) == \"glassy\" ]]",
    "action": "void-bar background glassy"
  },
  "appearance.top-bar.background.clear": {
    "icon": "󰝣",
    "label": "Clear Bar",
    "checked": "[[ $(void-bar background) == \"none\" ]]",
    "action": "void-bar background none"
  },
  "appearance.top-bar.indicators": {
    "icon": "󰋽",
    "label": "Bar Indicators"
  },
  "appearance.top-bar.indicators.battery-percentage-on": {
    "icon": "󰁹",
    "label": "Show Battery %",
    "when": "void-hw-laptop && [[ $(void-bar get omarchy.power showPercentage) != true ]]",
    "action": "void-shell omarchy.power togglePercentage"
  },
  "appearance.top-bar.indicators.battery-percentage-off": {
    "icon": "󰁹",
    "label": "Hide Battery %",
    "when": "void-hw-laptop && [[ $(void-bar get omarchy.power showPercentage) == true ]]",
    "action": "void-shell omarchy.power togglePercentage"
  },
  "appearance.top-bar.indicators.clock": {
    "icon": "󰥔",
    "label": "Clock"
  },
  "appearance.top-bar.indicators.clock.sunday-24h": {
    "icon": "󰥔",
    "label": "Sunday 14:30",
    "when": "[[ $(void-bar position) != \"left\" && $(void-bar position) != \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock format) == \"dddd HH:mm\" ]]",
    "action": "void-bar set omarchy.clock format \"dddd HH:mm\""
  },
  "appearance.top-bar.indicators.clock.sunday-12h": {
    "icon": "󰥔",
    "label": "Sunday 2:30 PM",
    "when": "[[ $(void-bar position) != \"left\" && $(void-bar position) != \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock format) == \"dddd h:mm AP\" ]]",
    "action": "void-bar set omarchy.clock format \"dddd h:mm AP\""
  },
  "appearance.top-bar.indicators.clock.sunday-seconds-24h": {
    "icon": "󰥔",
    "label": "Sunday 14:30:05",
    "when": "[[ $(void-bar position) != \"left\" && $(void-bar position) != \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock format) == \"dddd HH:mm:ss\" ]]",
    "action": "void-bar set omarchy.clock format \"dddd HH:mm:ss\""
  },
  "appearance.top-bar.indicators.clock.sunday-seconds-12h": {
    "icon": "󰥔",
    "label": "Sunday 2:30:05 PM",
    "when": "[[ $(void-bar position) != \"left\" && $(void-bar position) != \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock format) == \"dddd h:mm:ss AP\" ]]",
    "action": "void-bar set omarchy.clock format \"dddd h:mm:ss AP\""
  },
  "appearance.top-bar.indicators.clock.time-24h": {
    "icon": "󰥔",
    "label": "14:30",
    "when": "[[ $(void-bar position) != \"left\" && $(void-bar position) != \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock format) == \"HH:mm\" ]]",
    "action": "void-bar set omarchy.clock format \"HH:mm\""
  },
  "appearance.top-bar.indicators.clock.time-12h": {
    "icon": "󰥔",
    "label": "2:30 PM",
    "when": "[[ $(void-bar position) != \"left\" && $(void-bar position) != \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock format) == \"h:mm AP\" ]]",
    "action": "void-bar set omarchy.clock format \"h:mm AP\""
  },
  "appearance.top-bar.indicators.clock.date-24h": {
    "icon": "󰥔",
    "label": "Sun 3 May 14:30",
    "when": "[[ $(void-bar position) != \"left\" && $(void-bar position) != \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock format) == \"ddd d MMM HH:mm\" ]]",
    "action": "void-bar set omarchy.clock format \"ddd d MMM HH:mm\""
  },
  "appearance.top-bar.indicators.clock.date-12h": {
    "icon": "󰥔",
    "label": "Sun 3 May 2:30 PM",
    "when": "[[ $(void-bar position) != \"left\" && $(void-bar position) != \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock format) == \"ddd d MMM h:mm AP\" ]]",
    "action": "void-bar set omarchy.clock format \"ddd d MMM h:mm AP\""
  },
  "appearance.top-bar.indicators.clock.week": {
    "icon": "󰥔",
    "label": "3 May W18 2026",
    "when": "[[ $(void-bar position) != \"left\" && $(void-bar position) != \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock format) == \"d MMMM 'W'ww yyyy\" ]]",
    "action": "void-bar set omarchy.clock format \"d MMMM 'W'ww yyyy\""
  },
  "appearance.top-bar.indicators.clock.iso": {
    "icon": "󰥔",
    "label": "2026-05-03 14:30",
    "when": "[[ $(void-bar position) != \"left\" && $(void-bar position) != \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock format) == \"yyyy-MM-dd HH:mm\" ]]",
    "action": "void-bar set omarchy.clock format \"yyyy-MM-dd HH:mm\""
  },
  "appearance.top-bar.indicators.clock.stacked-24h": {
    "icon": "󰥔",
    "label": "14 — 30",
    "when": "[[ $(void-bar position) == \"left\" || $(void-bar position) == \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock verticalFormat) == $'HH\\n—\\nmm' ]]",
    "action": "void-bar set omarchy.clock verticalFormat $'HH\\n—\\nmm'"
  },
  "appearance.top-bar.indicators.clock.stacked-12h": {
    "icon": "󰥔",
    "label": "2 — 30 PM",
    "when": "[[ $(void-bar position) == \"left\" || $(void-bar position) == \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock verticalFormat) == $'h\\n—\\nmm\\nAP' ]]",
    "action": "void-bar set omarchy.clock verticalFormat $'h\\n—\\nmm\\nAP'"
  },
  "appearance.top-bar.indicators.clock.stacked-date": {
    "icon": "󰥔",
    "label": "03 May W18 '26",
    "when": "[[ $(void-bar position) == \"left\" || $(void-bar position) == \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock verticalFormat) == $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy' ]]",
    "action": "void-bar set omarchy.clock verticalFormat $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy'"
  },
  "appearance.top-bar.indicators.clock.stacked-time": {
    "icon": "󰥔",
    "label": "14 30",
    "when": "[[ $(void-bar position) == \"left\" || $(void-bar position) == \"right\" ]]",
    "checked": "[[ $(void-bar get omarchy.clock verticalFormat) == $'HH\\nmm' ]]",
    "action": "void-bar set omarchy.clock verticalFormat $'HH\\nmm'"
  },
  "appearance.top-bar.position.top": {
    "icon": "󰁝",
    "label": "Top Bar",
    "action": "void-bar position top"
  },
  "appearance.top-bar.position.bottom": {
    "icon": "󰁅",
    "label": "Bottom Bar",
    "action": "void-bar position bottom"
  },
  "appearance.top-bar.position.left": {
    "icon": "󰁍",
    "label": "Left Bar",
    "action": "void-bar position left"
  },
  "appearance.top-bar.position.right": {
    "icon": "󰁔",
    "label": "Right Bar",
    "action": "void-bar position right"
  },
  "appearance.windows": {
    "icon": "󰖲",
    "label": "Windows"
  },
  "appearance.windows.gaps-on": {
