#!/usr/bin/env bash
set -euo pipefail
slug="${1:-tokyo-night}"
THEMES_DIR="$HOME/.config/themes"

if [ ! -d "$THEMES_DIR/$slug" ]; then
    notify-send "Theme Error" "Unknown theme: $slug"
    exit 1
fi

mkdir -p "$HOME/.local/state/omarchy/current/theme"
echo "$slug" > "$HOME/.local/state/omarchy/current/theme.name"

cp "$THEMES_DIR/$slug/theme.json" "$HOME/.config/quickshell/theme.json"
cp "$THEMES_DIR/$slug/colors.toml" "$HOME/.config/quickshell/colors.toml"
cp "$THEMES_DIR/$slug/shell.toml" "$HOME/.config/quickshell/shell.toml"
cp "$THEMES_DIR/$slug/colors.toml" "$HOME/.local/state/omarchy/current/theme/colors.toml"
cp "$THEMES_DIR/$slug/shell.toml" "$HOME/.local/state/omarchy/current/theme/shell.toml"

# If upstream omarchy-theme-set is installed from github.com/omacom/omarchy, invoke it too
if [ -x /usr/share/omarchy/bin/omarchy-theme-set ]; then
    /usr/share/omarchy/bin/omarchy-theme-set "$slug" >/dev/null 2>&1 || true
fi

cp "$THEMES_DIR/$slug/hypr-theme.conf" "$HOME/.config/hypr/conf/theme.conf"
hyprctl reload >/dev/null 2>&1 || true
notify-send "Theme Activated" "Switched to $slug"
