#!/usr/bin/env bash
# Launch a TUI program inside a centered floating terminal window (class: tui-float)
set -euo pipefail
[ $# -eq 0 ] && exit 1

if command -v foot >/dev/null 2>&1; then
    exec foot --app-id="tui-float" --title="TUI: $1" -e "$@"
elif command -v alacritty >/dev/null 2>&1; then
    exec alacritty --class "tui-float,tui-float" --title "TUI: $1" -e "$@"
elif command -v kitty >/dev/null 2>&1; then
    exec kitty --class "tui-float" --title "TUI: $1" -e "$@"
else
    exec ~/.local/bin/launch-term -e "$@"
fi
