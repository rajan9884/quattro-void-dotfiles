#!/usr/bin/env bash
# Authentic Omarchy audio stack initialization for Void Linux under Wayland / Hyprland
# Ensures PipeWire, WirePlumber, PipeWire-Pulse, Omarchy speaker tuning, and Jack detection start cleanly.

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true

# Single-instance flock to avoid race conditions during login
exec 200>"$XDG_RUNTIME_DIR/void-audio-init.lock"
flock -n 200 || exit 0

# Wait up to 5 seconds for ALSA sound hardware node to be readable
for i in $(seq 1 50); do
    if [ -r /dev/snd/controlC0 ] && [ -w /dev/snd/controlC0 ]; then
        break
    fi
    udevadm trigger --subsystem-match=sound 2>/dev/null || true
    sleep 0.1
done

# Clean up any stale sockets if PipeWire is not running
if ! pgrep -u "$USER" -x pipewire >/dev/null 2>&1; then
    rm -f "$XDG_RUNTIME_DIR"/pipewire-*.lock "$XDG_RUNTIME_DIR"/pipewire-0* "$XDG_RUNTIME_DIR"/pulse/native 2>/dev/null || true
    setsid nohup /usr/bin/pipewire >/dev/null 2>&1 &
    sleep 0.6
fi

# Ensure WirePlumber is running (started by PipeWire context.exec or standalone)
if ! pgrep -u "$USER" -x wireplumber >/dev/null 2>&1; then
    setsid nohup /usr/bin/wireplumber >/dev/null 2>&1 &
    sleep 0.4
fi

# Ensure PipeWire-Pulse is running
if ! pgrep -u "$USER" -x pipewire-pulse >/dev/null 2>&1 && ! pgrep -u "$USER" -f "pipewire.*pipewire-pulse.conf" >/dev/null 2>&1; then
    setsid nohup /usr/bin/pipewire -c pipewire-pulse.conf >/dev/null 2>&1 &
    sleep 0.3
fi

# Fix any persistent cubic volume clamp in WirePlumber state
if [ -f "$HOME/.local/state/wireplumber/default-routes" ]; then
    sed -i 's/0.003375, 0.003375/1.000000, 1.000000/g' "$HOME/.local/state/wireplumber/default-routes" 2>/dev/null || true
fi

# Ensure hardware ALSA mixer controls are unmuted and auto-mute disabled
if command -v amixer >/dev/null 2>&1; then
    for card in sofhdadsp 0 1; do
        amixer -c "$card" sset 'Auto-Mute Mode' 'Disabled' >/dev/null 2>&1 || true
        amixer -c "$card" set Master 100% unmute >/dev/null 2>&1 || true
        amixer -c "$card" set Headphone 100% unmute >/dev/null 2>&1 || true
        amixer -c "$card" set Speaker 100% unmute >/dev/null 2>&1 || true
        amixer -c "$card" cset name='Dmic0 Capture Switch' on >/dev/null 2>&1 || true
        amixer -c "$card" cset name='Capture Switch' on >/dev/null 2>&1 || true
        amixer -c "$card" cset name='Capture Volume' 50,50 >/dev/null 2>&1 || true
        amixer -c "$card" cset name='Dmic0 Capture Volume' 60,60 >/dev/null 2>&1 || true
        amixer -c "$card" cset name='PGA2.0 2 Master Capture Volume' 60,60 >/dev/null 2>&1 || true
    done
fi

# Ensure default audio source is Digital Microphone if present
if command -v wpctl >/dev/null 2>&1; then
    dmic_id="$(wpctl status 2>/dev/null | awk '/Digital Microphone/ {gsub(/[^0-9]/, "", $1); if ($1 != "") {print $1; exit}}')"
    if [ -n "$dmic_id" ]; then
        wpctl set-default "$dmic_id" >/dev/null 2>&1 || true
    fi
fi
if command -v pactl >/dev/null 2>&1; then
    dmic_name="$(pactl list sources short 2>/dev/null | awk '/HiFi__Mic1__source/ {print $2; exit}')"
    if [ -n "$dmic_name" ]; then
        pactl set-default-source "$dmic_name" >/dev/null 2>&1 || true
    fi
fi

# If Omarchy speaker tuning is installed, ensure its filter-chain host client is running
tuning_conf="${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/omarchy-speaker-tuning.conf"
if [ -f "$tuning_conf" ]; then
    if ! pgrep -u "$USER" -f "pipewire -c .*omarchy-speaker-tuning.conf" >/dev/null 2>&1; then
        setsid nohup /usr/bin/pipewire -c "$tuning_conf" >/dev/null 2>&1 &
        sleep 0.5
    fi
fi

# Ensure physical speaker volume in PipeWire is full 100% so tuning is loud and clear
if command -v pactl >/dev/null 2>&1; then
    spk_name="$(pactl list sinks short 2>/dev/null | awk '/HiFi__Speaker__sink/ {print $2; exit}')"
    if [ -n "$spk_name" ]; then
        pactl set-sink-volume "$spk_name" 100% >/dev/null 2>&1 || true
        pactl set-sink-mute "$spk_name" 0 >/dev/null 2>&1 || true
    fi

    # Ensure default sink points to omarchy_speaker_tuning if active
    if pactl list sinks short 2>/dev/null | grep -q "omarchy_speaker_tuning"; then
        current_sink="$(pactl get-default-sink 2>/dev/null || true)"
        if [ "$current_sink" != "omarchy_speaker_tuning" ] && [[ "$current_sink" == *"Speaker"* || "$current_sink" == "auto_null" || -z "$current_sink" ]]; then
            pactl set-default-sink omarchy_speaker_tuning >/dev/null 2>&1 || true
        fi
    fi
fi

# Start dynamic jack monitor daemon in background if not already running
if ! pgrep -u "$USER" -f "python3 /usr/local/bin/omarchy-audio-jack-monitor" >/dev/null 2>&1; then
    setsid nohup python3 /usr/local/bin/omarchy-audio-jack-monitor >/dev/null 2>&1 &
fi
