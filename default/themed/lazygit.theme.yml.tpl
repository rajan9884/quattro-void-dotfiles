gui:
  nerdFontsVersion: "3"
  border: rounded
  theme:
    activeBorderColor:
      - "{{ accent }}"
      - bold
    inactiveBorderColor:
      - "{{ muted }}"
    selectedLineBgColor:
      - "{{ lighter_background }}"
    optionsTextColor:
      - "{{ blue }}"
    selectedRangeBgColor:
      - "{{ selection }}"
    cherryPickedCommitBgColor:
      - "{{ cyan }}"
    cherryPickedCommitFgColor:
      - "{{ blue }}"
    unstagedChangesColor:
      - "{{ red }}"
    defaultFgColor:
      - "{{ foreground }}"
