{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "void",
    "padding": {
      "right": 1
    }
  },

  "display": {
    "separator": " ➜ ",
    "key": {
      "width": 14
    }
  },

  "modules": [
    {
      "type": "title"
    },
    "separator",

    {
      "type": "custom",
      "format": "\u001b[1;38;2;122,162,247m╭─────────────────────── SYSTEM ──────────────────────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "#7aa2f7"
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "keyColor": "#7aa2f7"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "#7aa2f7"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "#7aa2f7"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "#7aa2f7"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "#7aa2f7"
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;2;122,162,247m╰─────────────────────────────────────────────────────╯\u001b[0m"
    },

    {
      "type": "custom",
      "format": "\u001b[1;38;2;68,157,171m╭────────────────────── DESKTOP ──────────────────────╮\u001b[0m"
    },
    {
      "type": "display",
      "key": "󰍹 Display",
      "keyColor": "#449dab",
      "format": "{width}x{height} @ {refresh-rate} Hz {scale-factor}x {inch}''"
    },
    {
      "type": "de",
      "key": "󰘔 DE",
      "keyColor": "#449dab"
    },
    {
      "type": "wm",
      "key": "󰖲 WM",
      "keyColor": "#449dab"
    },
    {
      "type": "wmtheme",
      "key": "󰋜 WM Theme",
      "keyColor": "#449dab"
    },
    {
      "type": "font",
      "key": "󰛖 Font",
      "keyColor": "#449dab"
    },
    {
      "type": "cursor",
      "key": "󰇀 Cursor",
      "keyColor": "#449dab"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "#449dab"
    },
    {
      "type": "terminalfont",
      "key": " Term Font",
      "keyColor": "#449dab"
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;2;68,157,171m╰─────────────────────────────────────────────────────╯\u001b[0m"
    },

    {
      "type": "custom",
      "format": "\u001b[1;38;2;173,142,230m╭────────────────────── HARDWARE ─────────────────────╮\u001b[0m"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "#ad8ee6",
      "format": "{name} ({cores-online})"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "#ad8ee6",
      "format": "{vendor} {name} ({type})"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "keyColor": "#ad8ee6"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "#ad8ee6"
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;2;173,142,230m╰─────────────────────────────────────────────────────╯\u001b[0m"
    },

    "separator",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
