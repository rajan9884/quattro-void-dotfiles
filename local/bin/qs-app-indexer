#!/usr/bin/env bash
# Scans /usr/share/applications & ~/.local/share/applications and outputs JSON
# for the pure Quickshell UnifiedMenu / App Launcher (Zero Rofi / Walker needed!)
set -euo pipefail

OUT="/tmp/quattro-apps-rajan.json"

python3 - <<'PY' > "${OUT}.tmp" 2>/dev/null || echo "[]" > "${OUT}.tmp"
import glob
import json
import os
import re

dirs = [
    "/usr/share/applications",
    "/usr/local/share/applications",
    os.path.expanduser("~/.local/share/applications"),
]

apps = []
seen = set()

for d in dirs:
    for path in sorted(glob.glob(os.path.join(d, "*.desktop"))):
        try:
            name = None
            exec_cmd = None
            nodisplay = False
            terminal = False
            with open(path, "r", encoding="utf-8", errors="ignore") as f:
                in_entry = False
                for line in f:
                    line = line.strip()
                    if line == "[Desktop Entry]":
                        in_entry = True
                        continue
                    elif line.startswith("[") and line.endswith("]"):
                        if in_entry:
                            break
                    if not in_entry:
                        continue
                    if line.startswith("Name=") and name is None:
                        name = line.split("=", 1)[1].strip()
                    elif line.startswith("Exec=") and exec_cmd is None:
                        raw_exec = line.split("=", 1)[1].strip()
                        exec_cmd = re.sub(r"\s+%[fFuUdDnNickvm]", "", raw_exec)
                    elif line.startswith("NoDisplay=true"):
                        nodisplay = True
                    elif line.startswith("Terminal=true"):
                        terminal = True
            if name and exec_cmd and not nodisplay and name not in seen:
                seen.add(name)
                if terminal:
                    exec_cmd = f"~/.local/bin/launch-tui-float {exec_cmd}"
                apps.append({
                    "title": name,
                    "category": "App",
                    "icon": "󰀻",
                    "cmd": exec_cmd
                })
        except Exception:
            pass

print(json.dumps(apps))
PY

mv "${OUT}.tmp" "$OUT"
