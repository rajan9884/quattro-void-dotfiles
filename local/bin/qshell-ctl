#!/usr/bin/env bash
# ==============================================================================
# QUATTRO QUICKSHELL IPC CONTROLLER (qshell-ctl)
# Controls Omarchy Quattro Quickshell Menus, Panels, Lockscreen & OSD
# ==============================================================================
set -euo pipefail

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/void}"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}"
if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
    socket=$(ls -t "$runtime_dir"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n1)
    [[ -n $socket ]] && export WAYLAND_DISPLAY=${socket##*/}
fi

cmd="${1:-}"
arg="${2:-}"

send_ipc() {
    local action="$1"
    local p1="${2:-}"

    case "$action" in
        toggle)
            if [ "$p1" = "omarchy.apps" ]; then
                omarchy-shell -q omarchy.dock apps >/dev/null 2>&1 || omarchy-shell -q shell toggle omarchy.menu '{"menu":"apps"}' || true
            elif [ "$p1" = "omarchy.keybinds" ]; then
                omarchy-menu-keybindings >/dev/null 2>&1 || omarchy-shell -q shell toggle omarchy.menu '{"menu":"keybindings"}' || true
            else
                omarchy-shell -q shell toggle "$p1" "{}" >/dev/null 2>&1 || true
            fi
            ;;
        summon)
            omarchy-shell -q shell summon "$p1" "{}" >/dev/null 2>&1 || true
            ;;
        hide)
            omarchy-shell -q shell hide "$p1" >/dev/null 2>&1 || true
            ;;
        lock)
            omarchy-lock >/dev/null 2>&1 || omarchy-shell -q shell lock >/dev/null 2>&1 || true
            ;;
    esac
}

case "$cmd" in
    toggle)
        send_ipc "toggle" "$arg"
        ;;
    summon)
        send_ipc "summon" "$arg"
        ;;
    hide)
        send_ipc "hide" "$arg"
        ;;
    lock)
        send_ipc "lock"
        ;;
    osd)
        case "$arg" in
            volume-up)
                /usr/share/void/bin/void-audio-output-volume raise
                ;;
            volume-down)
                /usr/share/void/bin/void-audio-output-volume lower
                ;;
            volume-mute)
                /usr/share/void/bin/void-audio-output-volume mute-toggle
                ;;
            mic-mute)
                /usr/share/void/bin/void-audio-input-mute
                ;;
            brightness-up)
                /usr/share/void/bin/void-brightness-display +5%
                ;;
            brightness-down)
                /usr/share/void/bin/void-brightness-display 5%-
                ;;
        esac
        ;;
    *)
        echo "Usage: qshell-ctl {toggle|summon|hide|lock|osd} [target]"
        exit 1
        ;;
esac
