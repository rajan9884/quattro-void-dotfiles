#!/bin/bash

set -e

# Omarchy ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(void-default-agent 2>/dev/null) ]] && void-done ensure agent-setup-invitation; then
  void-notification-send -u critical -g 󰚩 "$(void-i18n firstRun.agentTitle)" \
    "$(void-i18n firstRun.agentBody)" \
    --exec void menu summon setup.default.agent
fi
