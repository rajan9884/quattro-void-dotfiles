#!/usr/bin/env bash
# Robust audio initialization for Void Linux under Wayland / Hyprland
set -euo pipefail

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

# Ensure runtime directory exists
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true

# If pipewire is not active, clean up stale sockets and spawn detached session
if ! pgrep -u "$USER" -x pipewire >/dev/null 2>&1; then
    rm -f "$XDG_RUNTIME_DIR"/pipewire-*.lock "$XDG_RUNTIME_DIR"/pipewire-0* "$XDG_RUNTIME_DIR"/pulse/native 2>/dev/null || true
    setsid /usr/bin/pipewire >/dev/null 2>&1 &
    sleep 0.5
fi

# WirePlumber and PipeWire-Pulse are usually auto-spawned via context.exec,
# but verify and launch if either is missing.
if ! pgrep -u "$USER" -x wireplumber >/dev/null 2>&1; then
    setsid /usr/bin/wireplumber >/dev/null 2>&1 &
fi

if ! pgrep -u "$USER" -x pipewire-pulse >/dev/null 2>&1; then
    setsid /usr/bin/pipewire-pulse >/dev/null 2>&1 &
fi

# Ensure hardware ALSA mixer controls are at 100% (0 dB) so PipeWire software volume has full dynamic range
if command -v amixer >/dev/null 2>&1; then
    for card in sofhdadsp 0 1; do
        amixer -c "$card" set Master 100% unmute >/dev/null 2>&1 || true
        amixer -c "$card" set Headphone 100% unmute >/dev/null 2>&1 || true
        amixer -c "$card" set Speaker 100% unmute >/dev/null 2>&1 || true
    done
fi

# If omarchy speaker tuning is installed, ensure its filter-chain host client is running
tuning_conf="${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/omarchy-speaker-tuning.conf"
if [ -f "$tuning_conf" ] && ! pgrep -u "$USER" -f "pipewire -c .*omarchy-speaker-tuning.conf" >/dev/null 2>&1; then
    setsid /usr/bin/pipewire -c "$tuning_conf" >/dev/null 2>&1 &
fi
