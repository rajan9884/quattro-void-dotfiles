#!/bin/bash

# omarchy:summary=Resolve the default browser desktop entry name

browser=$(env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings get default-web-browser 2>/dev/null)
if [[ -z "$browser" ]]; then
  browser=$(xdg-mime query default x-scheme-handler/http 2>/dev/null)
fi
if [[ -z "$browser" ]]; then
  browser=$(xdg-mime query default x-scheme-handler/https 2>/dev/null)
fi

# Fallback to chromium if installed, otherwise first available
if [[ -z "$browser" || "$browser" != *.desktop ]]; then
  if command -v chromium &>/dev/null; then
    browser="chromium.desktop"
  elif command -v google-chrome &>/dev/null; then
    browser="google-chrome.desktop"
  elif command -v firefox &>/dev/null; then
    browser="firefox.desktop"
  fi
fi

echo "$browser"
