#!/bin/bash

# void:summary=Remove a web app desktop launcher
# void:args=[name]

set -e

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
OLD_ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_DIR="$HOME/.local/share/applications/"

# Always index the launchers, so removal deletes the file that was found rather
# than a path rebuilt from the displayed name.
WEB_APPS=()
WEB_APP_PATHS=()
while IFS= read -r -d '' file; do
  if grep -q '^Exec=.*\(void-launch-webapp\|void-webapp-handler\).*' "$file"; then
    WEB_APPS+=("$(basename "${file%.desktop}")")
    WEB_APP_PATHS+=("$file")
  fi
done < <(find "$DESKTOP_DIR" -name '*.desktop' -print0 2>/dev/null)

path_for_web_app() {
  local wanted="$1" i
  for i in "${!WEB_APPS[@]}"; do
    if [[ ${WEB_APPS[$i]} == "$wanted" ]]; then
      printf '%s\n' "${WEB_APP_PATHS[$i]}"
      return 0
    fi
  done
}

if (( $# == 0 )); then
  if ((${#WEB_APPS[@]})); then
    mapfile -t SORTED_WEB_APPS < <(printf '%s\n' "${WEB_APPS[@]}" | sort)
    if [ -t 0 ] || [ -n "${TERM:-}" ]; then
      echo -e "\e[32m$(void-i18n webapp.selectRemove 2>/dev/null || echo "Select web app to remove:")\n\e[0m"
      APP_NAME=$(gum choose --header="Use arrow keys to select, Enter to confirm, Ctrl+C to cancel" "${SORTED_WEB_APPS[@]}")
    else
      APP_NAME=$(void-menu-select "$(void-i18n webapp.selectRemove 2>/dev/null || echo "Remove Web App")" "${SORTED_WEB_APPS[@]}" -- --width 875 --maxheight 600)
    fi
  else
    echo "No web apps installed to remove."
    sleep 2
    exit 0
  fi
else
  APP_NAME="$*"
fi

if [[ -z $APP_NAME ]]; then
  echo "You must select a web app to remove."
  exit 1
fi

icon_name=$(printf '%s\n' "$APP_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')
desktop_file=$(path_for_web_app "$APP_NAME")
rm -f "${desktop_file:-$DESKTOP_DIR/$APP_NAME.desktop}"
rm -f "$ICON_DIR/$icon_name.png" "$ICON_DIR/$APP_NAME.png" "$OLD_ICON_DIR/$APP_NAME.png"

if [[ ${OMARCHY_REMOVE_NOTIFY:-true} != "false" ]]; then
  void-notification-send -g  "$(void-i18n webapp.removed 2>/dev/null || echo "Removed")" "$APP_NAME"
fi
update-desktop-database "$DESKTOP_DIR" &>/dev/null
echo "Successfully removed $APP_NAME"
