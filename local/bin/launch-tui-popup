#!/usr/bin/env bash
# Launch a compact TUI popup window (class: tui-popup)
set -euo pipefail
[ $# -eq 0 ] && exit 1

if command -v foot >/dev/null 2>&1; then
    exec foot --app-id="tui-popup" --title="Popup: $1" -e "$@"
elif command -v alacritty >/dev/null 2>&1; then
    exec alacritty --class "tui-popup,tui-popup" --title "Popup: $1" -e "$@"
elif command -v kitty >/dev/null 2>&1; then
    exec kitty --class "tui-popup" --title "Popup: $1" -e "$@"
else
    exec ~/.local/bin/launch-term -e "$@"
fi
