#!/bin/bash

# omarchy:summary=Send the low battery warning notification and run battery-low hooks.
# omarchy:args=<percentage>
# omarchy:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: void-battery-low <percentage>" >&2
  exit 1
fi

level=$1

void-notification-send -g 󱐋 -u normal "$(void-i18n battery.lowTitle)" "$(void-i18n battery.lowBody "$level")" -i battery-caution -t 30000
void-hook battery-low "$level"
