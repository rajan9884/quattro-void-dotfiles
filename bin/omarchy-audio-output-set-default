#!/bin/bash

# omarchy:summary=Set the default audio output and move active streams
# omarchy:args=<node-id> <sink-name>
# omarchy:examples=omarchy audio output set default 42 alsa_output.pci-0000_00_1f.3.analog-stereo

node_id=${1:-}
sink_name=${2:-}

if [[ -z $node_id || -z $sink_name ]]; then
  echo "Usage: omarchy-audio-output-set-default <node-id> <sink-name>" >&2
  exit 1
fi

card_id="$(pactl list cards short 2>/dev/null | awk '/sof-hda-dsp|skl_hda_dsp_generic/ {print $1; exit}')"
card_id="${card_id:-53}"

if [[ "$sink_name" == *"Headphones"* ]]; then
  pactl set-card-profile "$card_id" "HiFi (HDMI1, HDMI2, HDMI3, Headphones, Mic1, Mic2)" 2>/dev/null || true
  for _ in {1..25}; do
    actual_sink="$(pactl list sinks short 2>/dev/null | awk '/HiFi__Headphones__sink/ {print $2; exit}')"
    [[ -n $actual_sink ]] && break
    sleep 0.04
  done
  if [[ -n ${actual_sink:-} ]]; then
    sink_name="$actual_sink"
    node_id="$(pactl list sinks short 2>/dev/null | awk -v s="$sink_name" '$2 == s {print $1; exit}')"
    pactl set-sink-mute "$sink_name" 0 2>/dev/null || true
    pactl set-sink-volume "$sink_name" 100% 2>/dev/null || true
    amixer -c sofhdadsp set Headphone 100% unmute 2>/dev/null || true
    amixer -c 0 set Headphone 100% unmute 2>/dev/null || true
  fi
elif [[ "$sink_name" == *"Speaker"* || "$sink_name" == "omarchy_speaker_tuning" ]]; then
  pactl set-card-profile "$card_id" "HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)" 2>/dev/null || true
  for _ in {1..25}; do
    actual_spk="$(pactl list sinks short 2>/dev/null | awk '/HiFi__Speaker__sink/ {print $2; exit}')"
    [[ -n $actual_spk ]] && break
    sleep 0.04
  done
  if [[ -n ${actual_spk:-} ]]; then
    pactl set-sink-volume "$actual_spk" 100% 2>/dev/null || true
    pactl set-sink-mute "$actual_spk" 0 2>/dev/null || true
    amixer -c sofhdadsp set Speaker 100% unmute 2>/dev/null || true
    amixer -c 0 set Speaker 100% unmute 2>/dev/null || true
  fi
  if [[ "$sink_name" == "omarchy_speaker_tuning" ]] && pactl list sinks short 2>/dev/null | grep -q "omarchy_speaker_tuning"; then
    node_id="$(pactl list sinks short 2>/dev/null | awk '$2 == "omarchy_speaker_tuning" {print $1; exit}')"
  elif [[ -n ${actual_spk:-} ]]; then
    sink_name="$actual_spk"
    node_id="$(pactl list sinks short 2>/dev/null | awk -v s="$sink_name" '$2 == s {print $1; exit}')"
  fi
fi

if [[ -n ${node_id:-} && "$node_id" != "-101" && "$node_id" != "-102" && "$node_id" != "0" ]]; then
  timeout 2 wpctl set-default "$node_id" 2>/dev/null || true
fi
timeout 2 pactl set-default-sink "$sink_name" 2>/dev/null || true

# Move only real application streams. A DSP filter-chain's own output is also a
# sink input but carries no application.name, and moving it would rewire the
# processing itself -- onto headphones, or into its own virtual sink, which is a
# cycle. EasyEffects' output stream must stay put for the same reason.
# pactl translates its headers; parse them in the C locale.
LC_ALL=C timeout 2 pactl list sink-inputs 2>/dev/null | awk '
  /^Sink Input #/ {id = substr($3, 2)}
  /application\.name = / {
    app = $0
    sub(/.*application\.name = "/, "", app)
    sub(/"$/, "", app)
    if (app != "EasyEffects") print id
  }' | while read -r input; do
  [[ -n $input ]] && timeout 2 pactl move-sink-input "$input" "$sink_name" 2>/dev/null || true
done
