#!/usr/bin/env bash
# Robust audio initialization for Void Linux under Wayland / Hyprland
set -euo pipefail

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true

# Exclusive single-instance lock to prevent concurrent races
exec 200>"$XDG_RUNTIME_DIR/void-audio-init.lock"
flock -n 200 || exit 0

# Trigger udev rule for sound in case early coldplug was missed
udevadm trigger --subsystem-match=sound 2>/dev/null || true

# Wait up to 5 seconds for ALSA sound hardware node to be readable
for i in $(seq 1 50); do
    if [ -r /dev/snd/controlC0 ] && [ -w /dev/snd/controlC0 ]; then
        break
    fi
    sleep 0.1
done

# If multiple wireplumber processes are running (stale or conflicting), clean them up
wp_count=$(pgrep -u "$USER" -x wireplumber 2>/dev/null | wc -l)
if [ "$wp_count" -gt 1 ]; then
    pkill -9 -u "$USER" -x wireplumber 2>/dev/null || true
    sleep 0.5
fi

# Clean up stale locks if pipewire is dead
if ! pgrep -u "$USER" -x pipewire >/dev/null 2>&1; then
    rm -f "$XDG_RUNTIME_DIR"/pipewire-*.lock "$XDG_RUNTIME_DIR"/pipewire-0* "$XDG_RUNTIME_DIR"/pulse/native 2>/dev/null || true
    setsid /usr/bin/pipewire >/dev/null 2>&1 &
    sleep 0.5
fi

# PipeWire automatically launches WirePlumber and PipeWire-Pulse via context.exec.
# Only launch them if they are completely absent after 1 second.
sleep 0.5
if ! pgrep -u "$USER" -x wireplumber >/dev/null 2>&1; then
    setsid /usr/bin/wireplumber >/dev/null 2>&1 &
    sleep 0.5
fi

if ! pgrep -u "$USER" -x pipewire-pulse >/dev/null 2>&1; then
    setsid /usr/bin/pipewire-pulse >/dev/null 2>&1 &
fi

# Ensure hardware ALSA mixer controls are at 100% (0 dB)
if command -v amixer >/dev/null 2>&1; then
    for card in sofhdadsp 0 1; do
        amixer -c "$card" set Master 100% unmute >/dev/null 2>&1 || true
        amixer -c "$card" set Headphone 100% unmute >/dev/null 2>&1 || true
        amixer -c "$card" set Speaker 100% unmute >/dev/null 2>&1 || true
    done
fi

# If omarchy speaker tuning is installed, ensure its filter-chain host client is running
tuning_conf="${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/omarchy-speaker-tuning.conf"
if [ -f "$tuning_conf" ]; then
    if ! pgrep -u "$USER" -f "pipewire -c .*omarchy-speaker-tuning.conf" >/dev/null 2>&1; then
        setsid /usr/bin/pipewire -c "$tuning_conf" >/dev/null 2>&1 &
    fi
fi
