#!/bin/bash

# omarchy:summary=Resolve current working directory for active terminal or pid
# omarchy:args=[pid]

pid="${1:-}"

if [[ -z "$pid" && -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl &>/dev/null && command -v jq &>/dev/null; then
  pid=$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty')
fi

if [[ -n "$pid" && "$pid" != "0" && -d "/proc/$pid/cwd" ]]; then
  readlink "/proc/$pid/cwd" 2>/dev/null || echo "$HOME"
else
  echo "$HOME"
fi
