#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if void-hw-fingerprint && [[ ! -f /etc/pam.d/omarchy-lock-fingerprint ]] &&
  void-done ensure fingerprint-setup-invitation; then
  void-notification-send -u critical -g 󰈷 "$(void-i18n firstRun.fingerprintTitle)" \
    "$(void-i18n firstRun.fingerprintBody)" \
    --exec void-launch-floating-terminal-with-presentation void-setup-security-fingerprint
fi
