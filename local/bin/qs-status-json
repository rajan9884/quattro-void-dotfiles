#!/usr/bin/env bash
set -u

audio_icon="󰕾"
audio_text="--%"
audio_vol=0
audio_muted="false"
mic_icon="󰍬"
mic_muted="false"
audio_sink="PipeWire Output"

if command -v wpctl >/dev/null 2>&1; then
    vol_raw=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo "Volume: 0.50")
    vol_pct=$(awk '/Volume:/ {printf "%d", $2 * 100}' <<<"$vol_raw")
    audio_vol="${vol_pct:-0}"
    if grep -q "MUTED" <<<"$vol_raw"; then
        audio_muted="true"
        audio_icon="󰝟"
        audio_text="Mute"
    else
        audio_text="${audio_vol}%"
        if [ "$audio_vol" -lt 30 ]; then
            audio_icon="󰕿"
        elif [ "$audio_vol" -lt 70 ]; then
            audio_icon="󰖀"
        else
            audio_icon="󰕾"
        fi
    fi
    mic_raw=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || echo "")
    if grep -q "MUTED" <<<"$mic_raw"; then
        mic_muted="true"
        mic_icon="󰍭"
    fi
fi

bright_icon="󰃠"
bright_text="100%"
bright_pct=100
nightlight="false"
pgrep -x wlsunset >/dev/null 2>&1 && nightlight="true"
if command -v brightnessctl >/dev/null 2>&1 && ls /sys/class/backlight/* >/dev/null 2>&1; then
    b_pct=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d '%' || echo "100")
    bright_pct="${b_pct:-100}"
    bright_text="${bright_pct}%"
else
    bright_icon="󰍹"
    bright_text="DP"
fi

wifi_icon="󰤭"
wifi_text="Offline"
wifi_connected="false"
wifi_enabled="true"
wifi_ssid="Disconnected"
ip_addr="127.0.0.1"

if command -v nmcli >/dev/null 2>&1; then
    radio_st=$(nmcli radio wifi 2>/dev/null || echo "enabled")
    [ "$radio_st" != "enabled" ] && wifi_enabled="false"
    active_con=$(nmcli -t -f TYPE,STATE,CONNECTION dev 2>/dev/null | grep ":connected:" | head -n1 || true)
    if [ -n "$active_con" ]; then
        con_type=$(cut -d: -f1 <<<"$active_con")
        con_name=$(cut -d: -f3 <<<"$active_con")
        wifi_connected="true"
        wifi_ssid="$con_name"
        if [ "$con_type" = "ethernet" ]; then
            wifi_icon="󰈀"
            wifi_text="ETH"
        else
            wifi_icon="󰤨"
            wifi_text="${con_name:0:12}"
        fi
    fi
fi
ip_cand=$(ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')
[ -n "$ip_cand" ] && ip_addr="$ip_cand"

bt_icon="󰂲"
bt_text="Off"
bt_powered="false"
bt_connected="false"
bt_device=""
if command -v bluetoothctl >/dev/null 2>&1; then
    if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
        bt_powered="true"
        bt_icon="󰂯"
        dev_name=$(bluetoothctl info 2>/dev/null | awk -F': ' '/Name:/ {print $2; exit}')
        if [ -n "$dev_name" ]; then
            bt_connected="true"
            bt_icon="󰂱"
            bt_device="$dev_name"
            bt_text="${dev_name:0:10}"
        else
            bt_text="On"
        fi
    fi
fi

bat_icon="󰁹"
bat_text="100%"
bat_pct=100
bat_status="AC Connected"
bat_charging="false"
bat_low="false"
bat_dir=$(ls -d /sys/class/power_supply/BAT* /sys/class/power_supply/battery* 2>/dev/null | head -n1 || true)
if [ -n "$bat_dir" ] && [ -f "$bat_dir/capacity" ]; then
    cap=$(cat "$bat_dir/capacity" 2>/dev/null || echo 100)
    status=$(cat "$bat_dir/status" 2>/dev/null || echo "Full")
    bat_pct="$cap"
    bat_status="$status"
    bat_text="${cap}%"
    if [ "$status" = "Charging" ] || [ "$status" = "Full" ]; then
        bat_charging="true"
        bat_icon="󰂄"
    else
        if [ "$cap" -le 15 ]; then
            bat_low="true"
            bat_icon="󰁺"
        elif [ "$cap" -le 45 ]; then
            bat_icon="󰁼"
        elif [ "$cap" -le 75 ]; then
            bat_icon="󰁿"
        else
            bat_icon="󰁹"
        fi
    fi
fi

cpu_load=$(awk '{printf "%d%%", $1 * 10}' /proc/loadavg 2>/dev/null || echo "2%")
mem_used=$(free -h 2>/dev/null | awk '/^Mem:/ {print $3}' || echo "1.5G")
uptime_str=$(uptime -p 2>/dev/null || echo "up")

media_title=""
media_status="Stopped"
if command -v playerctl >/dev/null 2>&1; then
    m_st=$(playerctl status 2>/dev/null || echo "Stopped")
    if [ "$m_st" = "Playing" ] || [ "$m_st" = "Paused" ]; then
        media_status="$m_st"
        m_raw=$(playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null | tr -d '"' || echo "")
        media_title="${m_raw:0:26}"
    fi
fi

printf '{"audio_icon":"%s","audio_text":"%s","audio_vol":%d,"audio_muted":%s,"mic_icon":"%s","mic_muted":%s,"audio_sink":"%s","bright_icon":"%s","bright_text":"%s","bright_pct":%d,"nightlight":%s,"wifi_icon":"%s","wifi_text":"%s","wifi_connected":%s,"wifi_enabled":%s,"wifi_ssid":"%s","ip_addr":"%s","bt_icon":"%s","bt_text":"%s","bt_powered":%s,"bt_connected":%s,"bt_device":"%s","bat_icon":"%s","bat_text":"%s","bat_pct":%d,"bat_status":"%s","bat_charging":%s,"bat_low":%s,"cpu_load":"%s","mem_used":"%s","uptime":"%s","media_title":"%s","media_status":"%s"}\n'     "$audio_icon" "$audio_text" "$audio_vol" "$audio_muted" "$mic_icon" "$mic_muted" "$audio_sink"     "$bright_icon" "$bright_text" "$bright_pct" "$nightlight"     "$wifi_icon" "$wifi_text" "$wifi_connected" "$wifi_enabled" "$wifi_ssid" "$ip_addr"     "$bt_icon" "$bt_text" "$bt_powered" "$bt_connected" "$bt_device"     "$bat_icon" "$bat_text" "$bat_pct" "$bat_status" "$bat_charging" "$bat_low"     "$cpu_load" "$mem_used" "$uptime_str" "$media_title" "$media_status"
