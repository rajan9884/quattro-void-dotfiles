#!/usr/bin/env bash
# ==============================================================================
# QUATTRO QUICKSHELL IPC CONTROLLER (qshell-ctl)
# Communicates with the single running Quickshell instance via `quickshell ipc`
# AND writes to `/tmp/quattro-qs-ipc-rajan` (FileView bridge) so it works across
# every Quickshell version on Void Linux.
# ==============================================================================

set -euo pipefail

IPC_FILE="/tmp/quattro-qs-ipc-rajan"
cmd="${1:-}"
arg="${2:-}"

send_ipc() {
    local action="$1"
    local p1="${2:-}"
    local p2="${3:-}"
    local p3="${4:-0}"
    printf "%s|%s|%s|%s|%s\n" "$action" "$p1" "$p2" "$p3" "$(date +%s%N)" > "$IPC_FILE"
    if command -v quickshell >/dev/null 2>&1; then
        case "$action" in
            toggle) quickshell ipc call shell toggle "$p1" >/dev/null 2>&1 || true ;;
            summon) quickshell ipc call shell summon "$p1" >/dev/null 2>&1 || true ;;
            hide)   quickshell ipc call shell hide >/dev/null 2>&1 || true ;;
            lock)   quickshell ipc call shell lock >/dev/null 2>&1 || true ;;
        esac
    fi
}

case "$cmd" in
    toggle)
        [ "$arg" = "menu" ] || [ "$arg" = "apps" ] && ~/.local/bin/qs-app-indexer >/dev/null 2>&1 &
        send_ipc "toggle" "$arg"
        ;;
    summon)
        send_ipc "summon" "$arg"
        ;;
    hide)
        send_ipc "hide"
        ;;
    lock)
        send_ipc "lock"
        ;;
    bar-bg)
        send_ipc "bar-bg"
        ;;
    osd)
        case "$arg" in
            volume-up)
                wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
                vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d", $2 * 100}')
                send_ipc "osd" "󰕾" "Volume" "$vol"
                ;;
            volume-down)
                wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
                vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d", $2 * 100}')
                send_ipc "osd" "󰖀" "Volume" "$vol"
                ;;
            volume-mute)
                wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
                raw=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
                if grep -q "MUTED" <<<"$raw"; then
                    send_ipc "osd" "󰝟" "Muted" "0"
                else
                    vol=$(awk '{printf "%d", $2 * 100}' <<<"$raw")
                    send_ipc "osd" "󰕾" "Volume" "$vol"
                fi
                ;;
            mic-mute)
                wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
                if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q "MUTED"; then
                    send_ipc "osd" "󰍭" "Mic Muted" "0"
                else
                    send_ipc "osd" "󰍬" "Mic Active" "100"
                fi
                ;;
            brightness-up)
                brightnessctl set 5%+ >/dev/null 2>&1 || true
                b=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d '%' || echo 100)
                send_ipc "osd" "󰃠" "Brightness" "${b:-100}"
                ;;
            brightness-down)
                brightnessctl set 5%- >/dev/null 2>&1 || true
                b=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d '%' || echo 100)
                send_ipc "osd" "󰃠" "Brightness" "${b:-100}"
                ;;
        esac
        ;;
    *)
        echo "Usage: qshell-ctl {toggle|summon|hide|lock|bar-bg|osd} [target]"
        exit 1
        ;;
esac
