#!/usr/bin/env bash
# ==============================================================================
# QUATTRO SHELL SUPERVISOR & LAUNCHER FOR VOID LINUX
# Launches and supervises the authentic Quickshell Omarchy Quattro Desktop
# ==============================================================================
set -u

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export QS_DISABLE_FILE_WATCHER=1
export QS_NO_RELOAD_POPUP=1

# Recover WAYLAND_DISPLAY if unset
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}"
if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
    socket=$(ls -t "$runtime_dir"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n1)
    [[ -n $socket ]] && export WAYLAND_DISPLAY=${socket##*/}
fi

# Clean up stale locks or sockets
pkill -x quickshell 2>/dev/null || true
rm -f "$runtime_dir"/omarchy-shell-*.sock 2>/dev/null || true
sleep 0.3

# Choose shell root: prefer user ~/.config/quickshell, fallback to /usr/share/omarchy/shell
SHELL_PATH="$HOME/.config/quickshell"
if [ ! -f "$SHELL_PATH/shell.qml" ] && [ -f "$OMARCHY_PATH/shell/shell.qml" ]; then
    SHELL_PATH="$OMARCHY_PATH/shell"
fi

startup_bg=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null || echo "")
export OMARCHY_STARTUP_BACKGROUND="$startup_bg"

while true; do
    quickshell -n -p "$SHELL_PATH"
    status=$?
    # Clean exit or compositor shut down
    if (( status == 0 )) || ! hyprctl monitors >/dev/null 2>&1; then
        exit 0
    fi
    sleep 1
done
